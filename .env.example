# Garden Guide server configuration
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/garden_guide
JWT_SECRET=replace-with-a-long-random-secret

# Frontend API URL. Leave empty in production when frontend and API share one origin.
VITE_API_BASE_URL=

# Optional real AI provider (server-side only; never expose secrets in VITE_* variables)
# OpenAI-compatible endpoint:
# Configure one AI provider for open-ended Garden AI. Keep keys server-side only.
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
# Or use Gemini's OpenAI-compatible endpoint by setting GEMINI_API_KEY only.
GEMINI_API_KEY=

# Optional admin seed credentials
ADMIN_EMAIL=
ADMIN_PASSWORD=
